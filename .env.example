# Twenty CRM (Settings -> API & Webhooks -> API keys)
TWENTY_BASE_URL=https://crm.tooling.pulsover.io
TWENTY_API_KEY=

# Slack (api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...        # Socket Mode, scope connections:write
SLACK_SIGNING_SECRET=
SLACK_NOTIFY_CHANNEL=C0123456789  # channel ID for opportunity notifications

# HTTP server (Twenty webhook endpoint: POST /webhooks/twenty)
PORT=3000

# Optional: secret shown by Twenty for the webhook; enables signature verification
TWENTY_WEBHOOK_SECRET=
