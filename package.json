{
  "name": "twenty-slack-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Slack app bridging a Slack workspace to a self-hosted Twenty CRM (deterministic, no LLM).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:blocks": "tsx --env-file=.env scripts/validate-blocks.ts"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "@slack/types": "^3.2.0",
    "@slack/web-api": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
