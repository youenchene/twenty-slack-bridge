{
  "display_information": {
    "name": "Twenty CRM Bridge",
    "description": "Search and log to Twenty CRM from Slack"
  },
  "features": {
    "bot_user": {
      "display_name": "Twenty CRM",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/crm",
        "description": "Search Twenty CRM",
        "usage_hint": "<name, company or opportunity>",
        "should_escape": false
      }
    ],
    "shortcuts": [
      {
        "name": "Log to CRM",
        "type": "message",
        "callback_id": "log_to_crm",
        "description": "Attach this message as a note on a CRM record"
      }
    ],
    "unfurl_domains": [
      "crm.tooling.pulsover.io"
    ],
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "app_mentions:read",
        "links:read",
        "links:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "link_shared",
        "app_home_opened"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
